  <Hero />
  <BenefitsIntro />
  <Benefits />
  <Quote />
  <LocationJourney />
  <LocationMap />
  <ApartmentTypes />
  <ApartmentInfo />
  <Amenities />
  <Interior />
  <Architecture />
  <Features />
  <Cta />
  <Footer />

  <BookCallModal />
  <MenuModal />
  <FloatingTips />
