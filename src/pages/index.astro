---
import Layout from '~/layouts/Layout.astro';

import Header from '~/components/Header.astro';
import Hero from '~/components/sections/Hero.astro';
import BenefitsIntro from '~/components/sections/BenefitsIntro.astro';
import Benefits from '~/components/sections/Benefits.astro';
import Quote from '~/components/sections/Quote.astro';
import LocationJourney from '~/components/sections/LocationJourney.astro';
import LocationMap from '~/components/sections/LocationMap.astro';
import ApartmentTypes from '~/components/sections/ApartmentTypes.astro';
import ApartmentInfo from '~/components/sections/ApartmentInfo.astro';
import Amenities from '~/components/sections/Amenities.astro';
import Interior from '~/components/sections/Interior.astro';
import Architecture from '~/components/sections/Architecture.astro';
import Features from '~/components/sections/Features.astro';
import Cta from '~/components/sections/Cta.astro';
