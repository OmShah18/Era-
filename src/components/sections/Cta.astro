---
import type { ImageMetadata } from 'astro';
import WfImage from '~/components/WfImage.astro';
import { currentAttrs, currentClass } from '~/lib/nav';
import img_img_cta_1920 from '~/assets/images/img_cta_1920.webp';

interface Props {
  /** Background image (the homepage uses the sea-view render). */
  image?: ImageMetadata;
}

const { image = img_img_cta_1920 } = Astro.props;
const path = Astro.url.pathname;
---

<section data-bg="color" class="section theme_on-color">
  <div data-footer-clip="" class="container">
    <div class="cta-w">
      <div class="cta-s">
        <div class="u-48"></div>
        <div class="grid">
          <div class="cta-s_desc">
            <p data-scroll-reveal="p" class="l1 a-center">
              A short conversation is enough to understand which apartment fits your use case — whether it is a family
              second home, a longer stay, or a place to return to year after year.
            </p>
          </div>
        </div>
        <div class="u-272"></div>
        <div class="grid">
          <div class="cta-s_title">
            <h2 data-scroll-reveal="h" class="h1 a-center">Perfect <br />sea views</h2>
            <div class="u-32"></div>
            <h3 data-scroll-reveal="h" class="c1 a-center">From rooftop terraces</h3>
            <div class="u-160"></div>
            <div data-scroll-reveal="ctn" class="cta-s_title_btn">
              <div hover-btn-circle="" data-magnetic-btn="" hover-nav-item-trigger="" class="btn-circle">
                <div data-magnetic-inner="" class="btn-circle_label">
                  <a
                    hover-nav-item=""
                    aria-label="View available apartments"
                    href="/apartments"
                    {...currentAttrs('/apartments', path)}
                    class:list={['nav-item w-inline-block', currentClass('/apartments', path)]}
                    ><div class="nav-item_label">
                      <div class="nav-item_label_text">
                        <div hover="text" class="l1">View available apartments</div>
                      </div>
                      <div class="nav-item_label_text is-2">
                        <div hover="text" class="l1">View available apartments</div>
                      </div>
                    </div></a
                  >
                </div>
                <div class="btn-circle_bg w-embed">
                  <svg data-circle viewBox="0 0 208 208" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                    <circle
                      data-arc
                      cx="104"
                      cy="104"
                      r="103.5"
                      stroke="currentColor"
                      stroke-width="1"
                      fill="none"
                      transform="rotate(-150 104 104)"
                    />
                    <circle
                      data-arc
                      cx="104"
                      cy="104"
                      r="103.5"
                      stroke="currentColor"
                      stroke-width="1"
                      fill="none"
                      transform="rotate(30 104 104)"
                    />

                    <circle
                      cx="104"
                      cy="104"
                      r="103.5"
                      stroke="var(--_colors---base-1000--line)"
                      stroke-width="1"
                      fill="none"
                    />
                  </svg>
                </div>
                <a
                  aria-label="View available apartments"
                  href="/apartments"
                  {...currentAttrs('/apartments', path)}
                  class:list={['btn-circle_link w-inline-block', currentClass('/apartments', path)]}
                ></a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="w_bg">
        <div data-parallax="w" class="img-w">
          <WfImage src={image} widths={[500, 800, 1080, 1600, 1920]} format="webp" data-parallax="img" loading="eager" alt="" sizes="(max-width: 1920px) 100vw, 1920px" class="img-p" />
          <div class="img-over-grad from-top _4x"></div>
          <div class="img-over-grad"></div>
          <div class="img-over-grad"></div>
        </div>
      </div>
    </div>
  </div>
</section>
