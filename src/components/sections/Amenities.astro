---
import WfImage from '~/components/WfImage.astro';
import img_era_residence_gated_community from '~/assets/images/era-residence-gated-community.webp';
import img_era_residence_landscaping_2 from '~/assets/images/era-residence-landscaping-2.webp';
import img_era_residence_parking from '~/assets/images/era-residence-parking.webp';
import img_era_residence_pool from '~/assets/images/era-residence-pool.webp';
import img_era_residence_spa_and_gym from '~/assets/images/era-residence-spa-and-gym.webp';
---

<div class="amen-scroll-area">
  <div class="scroll-area_screen">
    <section class="section clip theme_on-color">
      <div class="container">
        <div class="amen-w">
          <div class="amen-s">
            <div data-tabs-hilight="ver" data-tabs="" class="amen-s_cms">
              <div class="amen-cms w-dyn-list">
                <div role="list" class="amen-cms_list w-dyn-items">
                  <div
                    data-reveal-first=""
                    data-tab-content="gated-community"
                    role="listitem"
                    class="amen-cms_list_item w-dyn-item"
                  >
                    <div data-parallax="w" class="amen-slide">
                      <div class="amen-slide_b">
                        <div class="grid">
                          <div class="amen-slide_title">
                            <h3 data-scroll-reveal="p" data-tab="p" class="l1">Gated community</h3>
                            <div class="u-32"></div>
                          </div>
                          <div class="amen-slide_desc w-clearfix">
                            <div class="red-line"></div>
                            <h4 data-scroll-reveal="p" data-tab="p" class="h5">
                              Instead of corridors, walking paths connect the apartments — making Era Residence feel
                              closer to a group of private homes than a standard
                            </h4>
                          </div>
                        </div>
                        <div class="u-48"></div>
                      </div>
                      <div class="amen-slide_img">
                        <div data-tab="slide" class="img-w">
                          <div class="img-w"><WfImage src={img_era_residence_gated_community} widths={[500, 800, 1080, 1600, 1920]} format="webp" data-parallax="img-in" loading="eager" alt="" sizes="100vw" class="img-p" /></div>
                          <div class="img-over-grad from-top"></div>
                          <div class="img-over-grad from-bot _4x bot"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div
                    data-reveal-first=""
                    data-tab-content="swimming-pool-2"
                    role="listitem"
                    class="amen-cms_list_item w-dyn-item"
                  >
                    <div data-parallax="w" class="amen-slide">
                      <div class="amen-slide_b">
                        <div class="grid">
                          <div class="amen-slide_title">
                            <h3 data-scroll-reveal="p" data-tab="p" class="l1">Swimming Pool</h3>
                            <div class="u-32"></div>
                          </div>
                          <div class="amen-slide_desc w-clearfix">
                            <div class="red-line"></div>
                            <h4 data-scroll-reveal="p" data-tab="p" class="h5">
                              Saltwater swimming pool, Children’s pool, Sauna, jacuzzi and wellness shower
                            </h4>
                          </div>
                        </div>
                        <div class="u-48"></div>
                      </div>
                      <div class="amen-slide_img">
                        <div data-tab="slide" class="img-w">
                          <div class="img-w"><WfImage src={img_era_residence_pool} widths={[500, 800, 1080, 1600, 1920]} format="webp" data-parallax="img-in" loading="eager" alt="" sizes="100vw" class="img-p" /></div>
                          <div class="img-over-grad from-top"></div>
                          <div class="img-over-grad from-bot _4x bot"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div
                    data-reveal-first=""
                    data-tab-content="swimming-pool"
                    role="listitem"
                    class="amen-cms_list_item w-dyn-item"
                  >
                    <div data-parallax="w" class="amen-slide">
                      <div class="amen-slide_b">
                        <div class="grid">
                          <div class="amen-slide_title">
                            <h3 data-scroll-reveal="p" data-tab="p" class="l1">Parking area</h3>
                            <div class="u-32"></div>
                          </div>
                          <div class="amen-slide_desc w-clearfix">
                            <div class="red-line"></div>
                            <h4 data-scroll-reveal="p" data-tab="p" class="h5">
                              Each parking space includes pre-installation for optional EV charging.
                            </h4>
                          </div>
                        </div>
                        <div class="u-48"></div>
                      </div>
                      <div class="amen-slide_img">
                        <div data-tab="slide" class="img-w">
                          <div class="img-w"><WfImage src={img_era_residence_parking} widths={[500, 800, 1920]} format="webp" data-parallax="img-in" loading="eager" alt="" sizes="100vw" class="img-p" /></div>
                          <div class="img-over-grad from-top"></div>
                          <div class="img-over-grad from-bot _4x bot"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div
                    data-reveal-first=""
                    data-tab-content="spa-gym"
                    role="listitem"
                    class="amen-cms_list_item w-dyn-item"
                  >
                    <div data-parallax="w" class="amen-slide">
                      <div class="amen-slide_b">
                        <div class="grid">
                          <div class="amen-slide_title">
                            <h3 data-scroll-reveal="p" data-tab="p" class="l1">Spa &amp; gym</h3>
                            <div class="u-32"></div>
                          </div>
                          <div class="amen-slide_desc w-clearfix">
                            <div class="red-line"></div>
                            <h4 data-scroll-reveal="p" data-tab="p" class="h5">
                              Designed exclusively for residents and their guests, the amenities at ERA encourage a
                              slower and more balanced Mediterranean lifestyle
                            </h4>
                          </div>
                        </div>
                        <div class="u-48"></div>
                      </div>
                      <div class="amen-slide_img">
                        <div data-tab="slide" class="img-w">
                          <div class="img-w"><WfImage src={img_era_residence_spa_and_gym} widths={[500, 800, 1080, 1600, 1920]} format="webp" data-parallax="img-in" loading="eager" alt="" sizes="100vw" class="img-p" /></div>
                          <div class="img-over-grad from-top"></div>
                          <div class="img-over-grad from-bot _4x bot"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div
                    data-reveal-first=""
                    data-tab-content="landscaping"
                    role="listitem"
                    class="amen-cms_list_item w-dyn-item"
                  >
                    <div data-parallax="w" class="amen-slide">
                      <div class="amen-slide_b">
                        <div class="grid">
                          <div class="amen-slide_title">
                            <h3 data-scroll-reveal="p" data-tab="p" class="l1">Landscaping</h3>
                            <div class="u-32"></div>
                          </div>
                          <div class="amen-slide_desc w-clearfix">
                            <div class="red-line"></div>
                            <h4 data-scroll-reveal="p" data-tab="p" class="h5">
                              The landscaping concept was designed to soften the architecture and strengthen the
                              connection between the residences and the Mediterranean environment.
                            </h4>
                          </div>
                        </div>
                        <div class="u-48"></div>
                      </div>
                      <div class="amen-slide_img">
                        <div data-tab="slide" class="img-w">
                          <div class="img-w"><WfImage src={img_era_residence_landscaping_2} widths={[500, 800, 1080, 1920]} format="webp" data-parallax="img-in" loading="eager" alt="" sizes="100vw" class="img-p" /></div>
                          <div class="img-over-grad from-top"></div>
                          <div class="img-over-grad from-bot _4x bot"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="amm-s_cms_tabs-w">
                <div class="grid">
                  <div class="amm-s_cms_tabs">
                    <div class="amen-tabs-cms w-dyn-list">
                      <div role="list" class="amen-tabs-cms_list w-dyn-items">
                        <div role="listitem" class="amen-tabs-cms_list_item w-dyn-item">
                          <div data-tab="" data-tab-trigger="gated-community" class="amen-tab">
                            <div data-scroll-reveal="p" class="h5">Gated community</div>
                          </div>
                        </div>
                        <div role="listitem" class="amen-tabs-cms_list_item w-dyn-item">
                          <div data-tab="" data-tab-trigger="swimming-pool-2" class="amen-tab">
                            <div data-scroll-reveal="p" class="h5">Swimming Pool</div>
                          </div>
                        </div>
                        <div role="listitem" class="amen-tabs-cms_list_item w-dyn-item">
                          <div data-tab="" data-tab-trigger="swimming-pool" class="amen-tab">
                            <div data-scroll-reveal="p" class="h5">Parking area</div>
                          </div>
                        </div>
                        <div role="listitem" class="amen-tabs-cms_list_item w-dyn-item">
                          <div data-tab="" data-tab-trigger="spa-gym" class="amen-tab">
                            <div data-scroll-reveal="p" class="h5">Spa &amp; gym</div>
                          </div>
                        </div>
                        <div role="listitem" class="amen-tabs-cms_list_item w-dyn-item">
                          <div data-tab="" data-tab-trigger="landscaping" class="amen-tab">
                            <div data-scroll-reveal="p" class="h5">Landscaping</div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div data-scroll-reveal="line" class="amm-s_cms_tabs_line">
                      <div data-tab-hilight="" class="amm-s_cms_tabs_line_hilight"></div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="amm-s_cms_btn-w b-desk">
                <div class="grid">
                  <div data-scroll-reveal="ctn" class="amm-s_cms_btn">
                    <div
                      data-modal-cta-btn="book-a-call"
                      data-magnetic-btn=""
                      hover-nav-item-trigger=""
                      hover-btn-circle=""
                      class="btn-circle"
                    >
                      <div data-magnetic-inner="" class="btn-circle_label">
                        <a hover-nav-item="" aria-label="Book a call now" href="#" class="nav-item w-inline-block"
                          ><div class="nav-item_label">
                            <div class="nav-item_label_text"><div hover="text" class="l1">Book a call now</div></div>
                            <div class="nav-item_label_text is-2">
                              <div hover="text" class="l1">Book a call now</div>
                            </div>
                          </div></a
                        >
                      </div>
                      <div class="btn-circle_bg w-embed">
                        <svg
                          data-circle
                          viewBox="0 0 208 208"
                          xmlns="http://www.w3.org/2000/svg"
                          width="100%"
                          height="100%"
                        >
                          <circle
                            data-arc
                            cx="104"
                            cy="104"
                            r="103.5"
                            stroke="currentColor"
                            stroke-width="1"
                            fill="none"
                            transform="rotate(-150 104 104)"
                          />
                          <circle
                            data-arc
                            cx="104"
                            cy="104"
                            r="103.5"
                            stroke="currentColor"
                            stroke-width="1"
                            fill="none"
                            transform="rotate(30 104 104)"
                          />

                          <circle
                            cx="104"
                            cy="104"
                            r="103.5"
                            stroke="var(--_colors---base-1000--line)"
                            stroke-width="1"
                            fill="none"
                          />
                        </svg>
                      </div>
                      <a aria-label="Book a call now" href="#" class="btn-circle_link w-inline-block"></a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <div class="hero_themes">
    <div data-bg="color" class="hero_themes_color"></div>
    <div data-bg="light" class="hero_themes_light"></div>
  </div>
</div>
