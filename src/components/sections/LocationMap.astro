---
import WfImage from '~/components/WfImage.astro';
import img_era_residence_master_plan from '~/assets/images/era-residence-master-plan.webp';
import img_img_clouds_02 from '~/assets/images/img_clouds_02.avif';
import img_img_clouds_33 from '~/assets/images/img_clouds_33.avif';
import img_img_clouds_47 from '~/assets/images/img_clouds_47.avif';
---

<section data-bg="color" class="section clip theme_on-color">
  <div class="container">
    <div data-parallax="w" class="loc-w">
      <div class="loc-w_over-grad"></div>
      <div class="loc-w_over-grad"></div>
      <div class="loc-w_clouds">
        <div data-marquee-css="" class="marquee">
          <div data-marquee-css="track" class="marquee_track">
            <div data-marquee-css="list" class="marquee_list">
              <div class="marquee_list_item"><WfImage src={img_img_clouds_33} widths={[500, 2146]} format="avif" loading="eager" sizes="(max-width: 2146px) 100vw, 2146px" alt="" class="clouds is-33" /></div>
              <div class="marquee_list_item"><WfImage src={img_img_clouds_33} widths={[500, 2146]} format="avif" loading="eager" sizes="(max-width: 2146px) 100vw, 2146px" alt="" class="clouds is-33" /></div>
            </div>
            <div data-marquee-css="list" class="marquee_list">
              <div class="marquee_list_item"><WfImage src={img_img_clouds_33} widths={[500, 2146]} format="avif" loading="eager" sizes="(max-width: 2146px) 100vw, 2146px" alt="" class="clouds is-33" /></div>
              <div class="marquee_list_item"><WfImage src={img_img_clouds_33} widths={[500, 2146]} format="avif" loading="eager" sizes="(max-width: 2146px) 100vw, 2146px" alt="" class="clouds is-33" /></div>
            </div>
          </div>
        </div>
      </div>
      <div class="loc-w_clouds">
        <div data-marquee-css="" class="marquee">
          <div data-marquee-css="track" class="marquee_track">
            <div data-marquee-css="list" class="marquee_list">
              <div class="marquee_list_item"><WfImage src={img_img_clouds_47} format="avif" loading="eager" alt="" class="clouds is-47" /></div>
              <div class="marquee_list_item"><WfImage src={img_img_clouds_47} format="avif" loading="eager" alt="" class="clouds is-47" /></div>
            </div>
            <div data-marquee-css="list" class="marquee_list">
              <div class="marquee_list_item"><WfImage src={img_img_clouds_47} format="avif" loading="eager" alt="" class="clouds is-47" /></div>
              <div class="marquee_list_item"><WfImage src={img_img_clouds_47} format="avif" loading="eager" alt="" class="clouds is-47" /></div>
            </div>
          </div>
        </div>
      </div>
      <div class="loc-w_clouds">
        <div data-marquee-css="" class="marquee">
          <div data-marquee-css="track" class="marquee_track">
            <div data-marquee-css="list" class="marquee_list">
              <div class="marquee_list_item"><WfImage src={img_img_clouds_02} format="avif" loading="eager" alt="" class="clouds is-02" /></div>
              <div class="marquee_list_item"><WfImage src={img_img_clouds_02} format="avif" loading="eager" alt="" class="clouds is-02" /></div>
            </div>
            <div data-marquee-css="list" class="marquee_list">
              <div class="marquee_list_item"><WfImage src={img_img_clouds_02} format="avif" loading="eager" alt="" class="clouds is-02" /></div>
              <div class="marquee_list_item"><WfImage src={img_img_clouds_02} format="avif" loading="eager" alt="" class="clouds is-02" /></div>
            </div>
          </div>
        </div>
      </div>
      <div class="loc-s">
        <div class="grid">
          <div class="loc-s_desc">
            <div class="b-desk">
              <div class="loc-s_desc_line"><div data-scroll-reveal="line" class="line-v"></div></div>
              <h3 data-scroll-reveal="p" class="l1">New Golden Mile, Estepona</h3>
              <div class="u-32"></div>
              <h4 data-scroll-reveal="p" class="p1">Costa del Sol</h4>
              <div class="u-32"></div>
              <h5 data-scroll-reveal="p" class="p1">Spain</h5>
            </div>
            <div class="b-mob">
              <div class="l1-list">
                <div class="ico-16">
                  <div class="ico w-embed">
                    <svg width="100%" height="100%" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M10.4717 12.4717C10.2113 12.7321 9.78866 12.7321 9.52831 12.4717L5.52831 8.47173C5.26796 8.21138 5.26796 7.78872 5.52831 7.52837L9.52831 3.52837C9.78866 3.26802 10.2113 3.26802 10.4717 3.52837C10.732 3.78872 10.732 4.21138 10.4717 4.47173L6.94335 8.00005L10.4717 11.5284C10.732 11.7887 10.732 12.2114 10.4717 12.4717Z"
                        fill="currentColor"
                      />
                    </svg>
                  </div>
                </div>
                <div class="l1">Drag to see more</div>
                <div class="ico-16">
                  <div class="ico w-embed">
                    <svg width="100%" height="100%" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M5.52833 3.52827C5.78868 3.26792 6.21134 3.26792 6.47169 3.52827L10.4717 7.52827C10.732 7.78862 10.732 8.21128 10.4717 8.47163L6.47169 12.4716C6.21134 12.732 5.78868 12.732 5.52833 12.4716C5.26798 12.2113 5.26798 11.7886 5.52833 11.5283L9.05665 7.99995L5.52833 4.47163C5.26798 4.21128 5.26798 3.78862 5.52833 3.52827Z"
                        fill="currentColor"
                      />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="u-48"></div>
        <div class="loc-w_decor theme_on-brand">
          <div class="w-embed">
            <style is:inline>
              .loc-w_decor {
                clip-path: polygon(
                  var(--_special-units---offset-l) 0,
                  calc(100% - var(--_special-units---offset-r)) 0%,
                  100% 101%,
                  0 101%
                );
              }
            </style>
          </div>
        </div>
      </div>
      <div data-parallax="img" class="loc-w_bg">
        <div class="loc-w_bg_img">
          <div class="pins-cms w-dyn-list"><div class="cms_empty-none w-dyn-empty"></div></div>
          <div class="img-w h-auto">
            <WfImage src={img_era_residence_master_plan} widths={[500, 800, 1080, 1920]} format="webp" loading="eager" sizes="(max-width: 1920px) 100vw, 1920px" alt="Coastal residential complex with pools, beachfront, roads, and distant mountains under clear blue sky." class="img h-auto" />
            <div class="img-over-grad from-bot bot _100vh"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
