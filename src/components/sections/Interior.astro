---
import WfImage from '~/components/WfImage.astro';
import img_era_residence_garden_2 from '~/assets/images/era-residence-garden-2.webp';
import img_era_residence_kitchen from '~/assets/images/era-residence-kitchen.webp';
import img_era_residence_terrace_2 from '~/assets/images/era-residence-terrace-2.webp';
import img_img_cam_03 from '~/assets/images/img_cam_03.webp';
import img_img_cam_07 from '~/assets/images/img_cam_07.webp';
import img_img_cam_09 from '~/assets/images/img_cam_09.webp';
---

<section class="section arch clip">
  <div class="container">
    <div class="interior-w">
      <div class="interior-s">
        <div class="u-272"></div>
        <div class="grid">
          <div class="interior-s_title">
            <h2 data-scroll-reveal="h" class="h1 a-center">The<br />space<br />to</h2>
            <div class="interior-s_title_a"><h3 data-scroll-reveal="a" class="a1 a-center">Live in</h3></div>
          </div>
        </div>
        <div class="interior-s_imgs">
          <div data-mob="off" data-parallax="ctn-down" class="interior-s_l">
            <div class="u-272"></div>
            <div class="grid _5-columns">
              <div data-video-playpause="" class="interior-s_l_img-w">
                <div class="interior-s_l_img">
                  <div data-scroll-reveal="slide" class="img-w"><WfImage src={img_era_residence_garden_2} widths={[500, 800, 1920]} format="webp" loading="eager" sizes="(max-width: 1920px) 100vw, 1920px" alt="Outdoor seating with modern chair, ottoman, table, and orange drink in a garden with pink flowers." class="img" /></div>
                </div>
                <div data-parallax="ctn-up" class="flower interior">
                  <video
                    muted=""
                    playsinline="playsinline"
                    loop=""
                    disablepictureinpicture=""
                    webkit-playsinline="webkit-playsinline"
                    poster="/images/bougainvillea-flowers_06.avif"
                    class="video"
                  >
                    <source src="/media/flowers/bougainvillea-flowers_06.webm" type="video/webm" />
                    <source src="/media/flowers/bougainvillea-flowers_06.mov" type="video/mp4" />
                  </video>
                </div>
              </div>
              <div class="interior-s_l_desc">
                <div class="u-16"></div>
                <h4 data-scroll-reveal="p" class="l1">
                  Optional upgrades are available: <br />• Private jacuzzi <br />• EV charging point installation
                  <br />• Photovoltaic panels
                </h4>
                <div class="u-160 b-mob"></div>
              </div>
            </div>
          </div>
          <div data-mob="off" data-parallax="ctn-up" class="interior-s_r">
            <div class="grid _5-columns">
              <div class="interior-s_r_img">
                <div data-scroll-reveal="slide" class="img-w"><WfImage src={img_era_residence_terrace_2} widths={[500, 800, 1080, 1920]} format="webp" loading="eager" sizes="(max-width: 1920px) 100vw, 1920px" alt="Sunlit terrace with cushioned seating, wooden tables, plants, flowering vine canopy, and ocean in the distance." class="img" /></div>
              </div>
              <div class="interior-s_r_lead w-clearfix">
                <div class="u-16"></div>
                <div class="red-line"></div>
                <h4 data-scroll-reveal="p" class="h5">
                  Every detail was selected to create homes that feel elegant, intuitive and effortless to live in
                </h4>
              </div>
              <div class="interior-s_r_desc">
                <div class="u-64"></div>
                <p data-scroll-reveal="p" class="p1">
                  Underfloor heating throughout the property. Climate automation systems. Smart lock access systems.
                  Electrically adjustable aluminium shutters. Schneider Electric DLIFE switches and mechanisms .
                </p>
                <div class="u-96"></div>
              </div>
              <div data-scroll-reveal="ctn" class="interior-s_r_btn">
                <div hover-btn-circle="" data-magnetic-btn="" hover-nav-item-trigger="" class="btn-circle">
                  <div data-magnetic-inner="" class="btn-circle_label">
                    <a
                      hover-nav-item=""
                      aria-label="View available apartments"
                      href="/apartments"
                      class="nav-item w-inline-block"
                      ><div class="nav-item_label">
                        <div class="nav-item_label_text">
                          <div hover="text" class="l1">View available apartments</div>
                        </div>
                        <div class="nav-item_label_text is-2">
                          <div hover="text" class="l1">View available apartments</div>
                        </div>
                      </div></a
                    >
                  </div>
                  <div class="btn-circle_bg w-embed">
                    <svg
                      data-circle
                      viewBox="0 0 208 208"
                      xmlns="http://www.w3.org/2000/svg"
                      width="100%"
                      height="100%"
                    >
                      <circle
                        data-arc
                        cx="104"
                        cy="104"
                        r="103.5"
                        stroke="currentColor"
                        stroke-width="1"
                        fill="none"
                        transform="rotate(-150 104 104)"
                      />
                      <circle
                        data-arc
                        cx="104"
                        cy="104"
                        r="103.5"
                        stroke="currentColor"
                        stroke-width="1"
                        fill="none"
                        transform="rotate(30 104 104)"
                      />

                      <circle
                        cx="104"
                        cy="104"
                        r="103.5"
                        stroke="var(--_colors---base-1000--line)"
                        stroke-width="1"
                        fill="none"
                      />
                    </svg>
                  </div>
                  <a
                    aria-label="View available apartments"
                    href="/apartments"
                    class="btn-circle_link w-inline-block"
                  ></a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="u-272"></div>
        <div class="grid">
          <div data-slider="" class="interior-s_gallery-cms">
            <div class="gallery-cms w-dyn-list">
              <div role="list" class="gallery-cms_list w-dyn-items">
                <div data-reveal-first="" data-slider="slide" role="listitem" class="gallery-cms_list_item w-dyn-item">
                  <div class="gallery-slide">
                    <div data-scroll-reveal="slide" data-slider="img" class="img-w"><WfImage src={img_img_cam_03} widths={[500, 800, 1080, 1600, 1920]} format="webp" loading="eager" alt="" sizes="100vw" class="img" /></div>
                  </div>
                </div>
                <div data-reveal-first="" data-slider="slide" role="listitem" class="gallery-cms_list_item w-dyn-item">
                  <div class="gallery-slide">
                    <div data-scroll-reveal="slide" data-slider="img" class="img-w"><WfImage src={img_img_cam_07} widths={[500, 800, 1080, 1600, 1920]} format="webp" loading="eager" alt="" sizes="100vw" class="img" /></div>
                  </div>
                </div>
                <div data-reveal-first="" data-slider="slide" role="listitem" class="gallery-cms_list_item w-dyn-item">
                  <div class="gallery-slide">
                    <div data-scroll-reveal="slide" data-slider="img" class="img-w"><WfImage src={img_img_cam_09} widths={[500, 800, 1080, 1600, 1920]} format="webp" loading="eager" alt="" sizes="100vw" class="img" /></div>
                  </div>
                </div>
                <div data-reveal-first="" data-slider="slide" role="listitem" class="gallery-cms_list_item w-dyn-item">
                  <div class="gallery-slide">
                    <div data-scroll-reveal="slide" data-slider="img" class="img-w"><WfImage src={img_era_residence_kitchen} widths={[500, 800, 1080, 1600, 1920]} format="webp" loading="eager" alt="" sizes="100vw" class="img" /></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="u-16"></div>
            <div class="interior-s_gallery-cms_pag">
              <div data-scroll-reveal="ctn" data-slider="pag" class="pag">
                <div data-slider="prev" class="pag_prev">
                  <div class="ico-16">
                    <div class="ico w-embed">
                      <svg
                        width="100%"
                        height="100%"
                        viewBox="0 0 16 16"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M10.4717 12.4717C10.2113 12.7321 9.78866 12.7321 9.52831 12.4717L5.52831 8.47173C5.26796 8.21138 5.26796 7.78872 5.52831 7.52837L9.52831 3.52837C9.78866 3.26802 10.2113 3.26802 10.4717 3.52837C10.732 3.78872 10.732 4.21138 10.4717 4.47173L6.94335 8.00005L10.4717 11.5284C10.732 11.7887 10.732 12.2114 10.4717 12.4717Z"
                          fill="currentColor"
                        />
                      </svg>
                    </div>
                  </div>
                  <div class="pag_prev_label"><div data-slider="current" class="l1">00</div></div>
                </div>
                <div class="pag_progress"><div data-slider="progress" class="pag_progress_fill"></div></div>
                <div data-slider="next" class="pag_next">
                  <div class="pag_prev_label"><div data-slider="next-num" class="l1">00</div></div>
                  <div class="ico-16">
                    <div class="ico w-embed">
                      <svg
                        width="100%"
                        height="100%"
                        viewBox="0 0 16 16"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M5.52833 3.52827C5.78868 3.26792 6.21134 3.26792 6.47169 3.52827L10.4717 7.52827C10.732 7.78862 10.732 8.21128 10.4717 8.47163L6.47169 12.4716C6.21134 12.732 5.78868 12.732 5.52833 12.4716C5.26798 12.2113 5.26798 11.7886 5.52833 11.5283L9.05665 7.99995L5.52833 4.47163C5.26798 4.21128 5.26798 3.78862 5.52833 3.52827Z"
                          fill="currentColor"
                        />
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="u-96"></div>
      </div>
      <div class="interior_themes">
        <div data-bg="light" class="interior_themes_light-1"></div>
        <div class="themes_row">
          <div data-bg="dark" class="interior_themes_dark-2"></div>
          <div data-bg="light" class="interior_themes_light-2"></div>
        </div>
        <div data-bg="light" class="interior_themes_light-3"></div>
      </div>
    </div>
  </div>
</section>
