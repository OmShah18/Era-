---
import WfImage from '~/components/WfImage.astro';
import img_era_residence_ground_floor_basement from '~/assets/images/era-residence-ground-floor-basement.webp';
import img_era_residence_landscaping from '~/assets/images/era-residence-landscaping.webp';
import img_era_residence_terrace_3 from '~/assets/images/era-residence-terrace-3.webp';
---

<section data-bg="light" data-snap="" class="section theme_on-brand">
  <div class="container">
    <div class="apart-type-w">
      <div class="apart-type-s">
        <div class="u-48 b-desk"></div>
        <div class="u-96 b-mob"></div>
        <div class="grid fill">
          <div data-slider="" class="apart-type-s_cms">
            <div class="apart-type-cms w-dyn-list">
              <div role="list" class="apart-type-cms_list w-dyn-items">
                <div
                  data-reveal-first=""
                  data-slider="slide"
                  role="listitem"
                  class="apart-type-cms_list_item w-dyn-item"
                >
                  <div class="apart-type-slide">
                    <div class="apart-type-slide_t b-desk"></div>
                    <div class="apart-type-slide_c">
                      <div class="grid _8-columns">
                        <div class="apart-type-slide_data">
                          <div class="data-list">
                            <div class="data-item">
                              <h4 data-scroll-reveal="p" data-slider="p" class="l1 reg">Bedrooms</h4>
                              <div class="u-8"></div>
                              <h5 data-scroll-reveal="p" data-slider="p" class="h5">3</h5>
                            </div>
                            <div class="data-item">
                              <h4 data-scroll-reveal="p" data-slider="p" class="l1 reg">Area up to</h4>
                              <div class="u-8"></div>
                              <h5 data-scroll-reveal="p" data-slider="p" class="h5">178 — 202 m²</h5>
                            </div>
                          </div>
                          <div class="u-48 b-mob"></div>
                        </div>
                        <div class="apart-type-slide_desc">
                          <p data-scroll-reveal="p" data-slider="p" class="p1 mob_a-center">
                            Private basement, direct outdoor access and a dedicated lower level.
                          </p>
                          <div class="u-24"></div>
                          <div data-scroll-reveal="ctn" data-slider="ctn" class="apart-type-slide_btn">
                            <a
                              aria-label="Explore Ground + basement"
                              hover-btn=""
                              hover-nav-item=""
                              data-wf--btn--variant="sec"
                              href="/apartments?type=ground-floor-basement"
                              class="btn w-inline-block"
                              ><div class="btn_label">
                                <div class="btn_label_text">
                                  <div hover="text" class="l1">Explore Ground + basement</div>
                                </div>
                                <div class="btn_label_text is-2">
                                  <div hover="text" class="l1">Explore Ground + basement</div>
                                </div>
                              </div>
                              <div class="btn_bg"><div hover="bg" class="btn_bg_fill"></div></div
                            ></a>
                          </div>
                          <div class="u-16 b-mob"></div>
                        </div>
                      </div>
                    </div>
                    <div class="apart-type-slide_b">
                      <div class="u-48 b-desk"></div>
                      <h3 data-scroll-reveal="h" data-slider="h" class="h2 a-center">Ground floor + basement</h3>
                      <div class="u-32 b-mob"></div>
                    </div>
                    <div class="apart-type-slide_img-w">
                      <div class="apart-type-slide_img">
                        <div data-scroll-reveal="slide" data-slider="img" class="img-w">
                          <WfImage src={img_era_residence_ground_floor_basement} widths={[500, 800, 1080, 1600, 1920]} format="webp" loading="eager" alt="" sizes="100vw" class="img" />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div
                  data-reveal-first=""
                  data-slider="slide"
                  role="listitem"
                  class="apart-type-cms_list_item w-dyn-item"
                >
                  <div class="apart-type-slide">
                    <div class="apart-type-slide_t b-desk"></div>
                    <div class="apart-type-slide_c">
                      <div class="grid _8-columns">
                        <div class="apart-type-slide_data">
                          <div class="data-list">
                            <div class="data-item">
                              <h4 data-scroll-reveal="p" data-slider="p" class="l1 reg">Bedrooms</h4>
                              <div class="u-8"></div>
                              <h5 data-scroll-reveal="p" data-slider="p" class="h5">2</h5>
                            </div>
                            <div class="data-item">
                              <h4 data-scroll-reveal="p" data-slider="p" class="l1 reg">Area up to</h4>
                              <div class="u-8"></div>
                              <h5 data-scroll-reveal="p" data-slider="p" class="h5">97 — 104 m²</h5>
                            </div>
                          </div>
                          <div class="u-48 b-mob"></div>
                        </div>
                        <div class="apart-type-slide_desc">
                          <p data-scroll-reveal="p" data-slider="p" class="p1 mob_a-center">
                            Step directly onto your terrace and into the communal gardens, blending indoor comfort with
                            outdoor living.
                          </p>
                          <div class="u-24"></div>
                          <div data-scroll-reveal="ctn" data-slider="ctn" class="apart-type-slide_btn">
                            <a
                              aria-label="Explore Ground floor"
                              hover-btn=""
                              hover-nav-item=""
                              data-wf--btn--variant="sec"
                              href="/apartments?type=ground-floor"
                              class="btn w-inline-block"
                              ><div class="btn_label">
                                <div class="btn_label_text">
                                  <div hover="text" class="l1">Explore Ground floor</div>
                                </div>
                                <div class="btn_label_text is-2">
                                  <div hover="text" class="l1">Explore Ground floor</div>
                                </div>
                              </div>
                              <div class="btn_bg"><div hover="bg" class="btn_bg_fill"></div></div
                            ></a>
                          </div>
                          <div class="u-16 b-mob"></div>
                        </div>
                      </div>
                    </div>
                    <div class="apart-type-slide_b">
                      <div class="u-48 b-desk"></div>
                      <h3 data-scroll-reveal="h" data-slider="h" class="h2 a-center">Ground Floor</h3>
                      <div class="u-32 b-mob"></div>
                    </div>
                    <div class="apart-type-slide_img-w">
                      <div class="apart-type-slide_img">
                        <div data-scroll-reveal="slide" data-slider="img" class="img-w">
                          <WfImage src={img_era_residence_landscaping} widths={[500, 800, 1080, 1600, 1920]} format="webp" loading="eager" alt="" sizes="100vw" class="img" />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div
                  data-reveal-first=""
                  data-slider="slide"
                  role="listitem"
                  class="apart-type-cms_list_item w-dyn-item"
                >
                  <div class="apart-type-slide">
                    <div class="apart-type-slide_t b-desk"></div>
                    <div class="apart-type-slide_c">
                      <div class="grid _8-columns">
                        <div class="apart-type-slide_data">
                          <div class="data-list">
                            <div class="data-item">
                              <h4 data-scroll-reveal="p" data-slider="p" class="l1 reg">Bedrooms</h4>
                              <div class="u-8"></div>
                              <h5 data-scroll-reveal="p" data-slider="p" class="h5">2-3</h5>
                            </div>
                            <div class="data-item">
                              <h4 data-scroll-reveal="p" data-slider="p" class="l1 reg">Area up to</h4>
                              <div class="u-8"></div>
                              <h5 data-scroll-reveal="p" data-slider="p" class="h5">124 — 243 m²</h5>
                            </div>
                          </div>
                          <div class="u-48 b-mob"></div>
                        </div>
                        <div class="apart-type-slide_desc">
                          <p data-scroll-reveal="p" data-slider="p" class="p1 mob_a-center">
                            Two floors crowned with panoramic views and a private rooftop solarium — the ultimate
                            expression of luxury living.
                          </p>
                          <div class="u-24"></div>
                          <div data-scroll-reveal="ctn" data-slider="ctn" class="apart-type-slide_btn">
                            <a
                              aria-label="Explore Penthouses"
                              hover-btn=""
                              hover-nav-item=""
                              data-wf--btn--variant="sec"
                              href="/apartments?type=penthouse-duplex"
                              class="btn w-inline-block"
                              ><div class="btn_label">
                                <div class="btn_label_text"><div hover="text" class="l1">Explore Penthouses</div></div>
                                <div class="btn_label_text is-2">
                                  <div hover="text" class="l1">Explore Penthouses</div>
                                </div>
                              </div>
                              <div class="btn_bg"><div hover="bg" class="btn_bg_fill"></div></div
                            ></a>
                          </div>
                          <div class="u-16 b-mob"></div>
                        </div>
                      </div>
                    </div>
                    <div class="apart-type-slide_b">
                      <div class="u-48 b-desk"></div>
                      <h3 data-scroll-reveal="h" data-slider="h" class="h2 a-center">Penthouse duplex</h3>
                      <div class="u-32 b-mob"></div>
                    </div>
                    <div class="apart-type-slide_img-w">
                      <div class="apart-type-slide_img">
                        <div data-scroll-reveal="slide" data-slider="img" class="img-w">
                          <WfImage src={img_era_residence_terrace_3} widths={[500, 800, 1080, 1920]} format="webp" loading="eager" alt="" sizes="100vw" class="img" />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="u-16"></div>
            <div data-scroll-reveal="ctn" data-slider="pag" class="pag">
              <div data-slider="prev" class="pag_prev">
                <div class="ico-16">
                  <div class="ico w-embed">
                    <svg width="100%" height="100%" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M10.4717 12.4717C10.2113 12.7321 9.78866 12.7321 9.52831 12.4717L5.52831 8.47173C5.26796 8.21138 5.26796 7.78872 5.52831 7.52837L9.52831 3.52837C9.78866 3.26802 10.2113 3.26802 10.4717 3.52837C10.732 3.78872 10.732 4.21138 10.4717 4.47173L6.94335 8.00005L10.4717 11.5284C10.732 11.7887 10.732 12.2114 10.4717 12.4717Z"
                        fill="currentColor"
                      />
                    </svg>
                  </div>
                </div>
                <div class="pag_prev_label"><div data-slider="current" class="l1">00</div></div>
              </div>
              <div class="pag_progress"><div data-slider="progress" class="pag_progress_fill"></div></div>
              <div data-slider="next" class="pag_next">
                <div class="pag_prev_label"><div data-slider="next-num" class="l1">00</div></div>
                <div class="ico-16">
                  <div class="ico w-embed">
                    <svg width="100%" height="100%" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M5.52833 3.52827C5.78868 3.26792 6.21134 3.26792 6.47169 3.52827L10.4717 7.52827C10.732 7.78862 10.732 8.21128 10.4717 8.47163L6.47169 12.4716C6.21134 12.732 5.78868 12.732 5.52833 12.4716C5.26798 12.2113 5.26798 11.7886 5.52833 11.5283L9.05665 7.99995L5.52833 4.47163C5.26798 4.21128 5.26798 3.78862 5.52833 3.52827Z"
                        fill="currentColor"
                      />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="u-48"></div>
      </div>
    </div>
  </div>
</section>
