            />
          </svg>
        </div>
        <div class="frame_lb w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 w-embed">
          <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <line
              x1="0%"
              y1="0%"
              x2="100%"
              y2="100%"
              stroke-width="1"
              stroke="currentColor"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
        <div class="frame_fill_tb w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 w-embed">
          <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="100%" height="100%" fill="var(--_colors---other--bg)" />
          </svg>
        </div>
        <div class="frame_fill_lr w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 w-embed">
          <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="100%" height="100%" fill="var(--_colors---other--bg)" />
          </svg>
        </div>
        <div class="frame_fill-c w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 lt w-embed">
          <svg
            width="100%"
            height="100%"
            viewBox="0 0 48 48"
            preserveAspectRatio="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <polygon points="24,0 48,24 24,48 0,24" fill="var(--_colors---other--bg)" />
          </svg>
        </div>
        <div class="frame_fill-c w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 rt w-embed">
          <svg
            width="100%"
