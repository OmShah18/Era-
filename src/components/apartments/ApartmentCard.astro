            xmlns="http://www.w3.org/2000/svg"
          >
            <polygon points="24,0 48,24 24,48 0,24" fill="var(--_colors---other--bg)" />
          </svg>
        </div>
        <div class="frame_fill-c w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 rb w-embed">
          <svg
            width="100%"
            height="100%"
            viewBox="0 0 48 48"
            preserveAspectRatio="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <polygon points="24,0 48,24 24,48 0,24" fill="var(--_colors---other--bg)" />
          </svg>
        </div>
        <div class="frame_fill-c w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 lb w-embed">
          <svg
            width="100%"
            height="100%"
            viewBox="0 0 48 48"
            preserveAspectRatio="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <polygon points="24,0 48,24 24,48 0,24" fill="var(--_colors---other--bg)" />
          </svg>
        </div>
      </div>
    </div>
    <div hover="shadow" class="apart-card_shadow"></div
  ></a>
</div>
