---
/** One apartment in the listing grid. Markup is the Webflow CMS template, verbatim. */
import WfImage from '~/components/WfImage.astro';
import type { Apartment } from '~/data/apartments';

interface Props {
  apartment: Apartment;
}

const { apartment } = Astro.props;
---

<div data-sort-item="" data-filter-item="" role="listitem" class="apart-cms_list_item w-dyn-item">
  <a data-sort-relevant={apartment.relevant} hover-apart-card="" href={`/apartments/${apartment.number}`} class="apart-card w-inline-block"
    ><div class="apart-card_c">
      <div class="apart-card_t">
        <h2 data-type={apartment.type} class="l2 a-center">{apartment.typeLabel}</h2>
        <div class="u-4"></div>
        <p id="" class="l2 reg a-center"><span>Completion: </span><span>{apartment.completion}</span></p>
      </div>
      <div class="u-16"></div>
      <div class="apart-card_img">
        <div class="apart-card_img_prim">
          <WfImage src={apartment.plan} widths={apartment.planWidths} format="webp" loading="eager" alt="" sizes="100vw" class="img contain" />
        </div>
      </div>
      <div class="u-16"></div>
      <div class="apart-card_b">
        <div class="apart-card_data-list">
          <p id="" class="l2 reg a-center"><span>№</span><span>{apartment.number}</span></p>
          <div class="data-divider"></div>
          <p id="" class="l2 reg a-center"><span>Block </span><span>{apartment.block}</span></p>
          <div class="data-divider"></div>
          <p id="" class="l2 reg a-center"><span>{apartment.floor}</span><span> floor</span></p>
        </div>
        <div class="u-16"></div>
        <div class="apart-card_info">
          <h3 id="" data-bed={apartment.bedrooms} class="h5"><span>{apartment.bedrooms}</span><span> bed</span></h3>
          <div class="h5">/</div>
          <h4 data-sort-area={apartment.area} class="h5"><span>{apartment.area}</span></h4>
        </div>
        <div class="u-16"></div>
        <div class="apart-card_add">
          <h5 id="" class="l1 a-center"><span>+ </span><span>{apartment.extra.size}</span><span> </span><span>{apartment.extra.label}</span></h5>
        </div>
      </div>
    </div>
    <div class="apart-card_decor">
      <div data-wf--decor--variant="med" class="decor">
        <div class="frame_l-tb w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 w-embed">
          <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <line
              x1="50%"
              y1="0%"
              x2="50%"
              y2="100%"
              stroke-width="1"
              stroke="currentColor"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
        <div class="frame_lt w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 w-embed">
          <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <line
              x1="0%"
              y1="100%"
              x2="100%"
              y2="0%"
              stroke-width="1"
              stroke="currentColor"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
        <div class="frame_t-lr w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 w-embed">
          <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <line
              x1="0%"
              y1="50%"
              x2="100%"
              y2="50%"
              stroke-width="1"
              stroke="currentColor"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
        <div class="frame_rt w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 w-embed">
          <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <line
              x1="0%"
              y1="0%"
              x2="100%"
              y2="100%"
              stroke-width="1"
              stroke="currentColor"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
        <div class="frame_r-tb w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 w-embed">
          <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <line
              x1="50%"
              y1="0%"
              x2="50%"
              y2="100%"
              stroke-width="1"
              stroke="currentColor"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </div>
        <div class="frame_rb w-variant-db77920b-274b-9558-1ced-34e87f5b7d94 w-embed">
          <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <line
              x1="0%"
