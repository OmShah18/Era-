---
/**
 * Optimised image that renders exactly like Webflow's markup: `src`, `srcset`, `sizes` and the
 * passed-through attributes, but no intrinsic `width`/`height`.
 *
 * Astro's <Image> adds width/height attributes. Several Webflow classes size images on a single
 * axis (e.g. `.clouds { height: 30rem }`), so those attributes would override the aspect-ratio
 * derived width and break the layout.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'width' | 'height'> & {
  src: ImageMetadata;
  /** Widths for the generated srcset (taken from Webflow's original srcset). */
  widths?: number[];
  format?: 'webp' | 'avif' | 'png' | 'jpeg';
  alt: string;
};

const { src, widths, format, ...attrs } = Astro.props;
const image = await getImage({ src, widths, format });
const srcset = image.srcSet.attribute || undefined;
---

<img src={image.src} srcset={srcset} {...attrs} />
